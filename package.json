{
  "name": "pi-nvim",
  "version": "1.0.0",
  "description": "Open Neovim from pi. Suspends the TUI, drops you into nvim (with the snacks.nvim git_status picker on dirty repos), then restores pi when you exit.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "neovim",
    "nvim",
    "snacks",
    "editor"
  ],
  "license": "MIT",
  "author": "Jozsef Lazar",
  "homepage": "https://github.com/joelazar/pi-nvim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelazar/pi-nvim.git"
  },
  "bugs": {
    "url": "https://github.com/joelazar/pi-nvim/issues"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
